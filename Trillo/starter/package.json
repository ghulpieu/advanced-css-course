{
  "name": "trillo",
  "version": "1.0.0",
  "description": "Landing page for trillo",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass sass/style.scss css/style.css -w",
    "dev:basic": "live-server",
    "start:dev": "run-p dev:basic watch:sass",
    "compile:sass": "sass scss/style.scss css/style.comp.css",
    "concat:css": "concat -o css/style.concat.css css/icon-font.css css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.concat.css -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --output-style compressed",
    "build:css": "run-s compile:sass concat:css prefix:css compress:css"
  },
  "author": "Gordon",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "concat": "^1.0.3",
    "npm-run-all2": "^9.0.4",
    "postcss-cli": "^12.0.0",
    "sass": "^1.108.2"
  }
}
