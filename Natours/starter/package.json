{
  "name": "starter",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass scss/style.scss css/style.css -w",
    "dev:basic": "live-server",
    "start:dev": "run-p dev:basic watch:sass",
    "compile:sass": "sass scss/style.scss css/style.comp.css",
    "concat:css": "concat -o css/style.concat.css css/icon-font.css css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.concat.css -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed",
    "build:css": "run-s compile:sass concat:css prefix:css compress:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "concat": "^1.0.3",
    "npm-run-all2": "^9.0.4",
    "postcss-cli": "^12.0.0",
    "sass": "^1.108.2"
  }
}
